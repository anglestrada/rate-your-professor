# Copy to .env and fill in. .env is gitignored, so never commit it.
# On your computer (through artemis-tunnel): DB_HOST=127.0.0.1, DB_PORT=3307
# On Artemis itself:                         DB_HOST=localhost, DB_PORT=3306
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=
DB_PASSWORD=
# csubryp is shared by the whole group. Switch to your personal database
# (same name as your Artemis username) when testing deletes or schema changes.
DB_NAME=csubryp
